# Database
MONGODB_URI=mongodb://localhost:27017/sales_crm

# Auth — use at least 32 random characters (openssl rand -base64 32)
JWT_SECRET=replace-with-a-long-random-secret

# Public app URL (used for links and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: country code added to 10-digit phone numbers on import
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91

# Timezone used for Google Sheets reporting and automation logs
APP_TIMEZONE=Asia/Kolkata

# API key for external lead intake (POST /api/leads/intake)
# Send it as `x-api-key: <key>` or `Authorization: Bearer <key>`.
LEAD_API_KEY=replace-with-a-long-random-key

# Optional reporting key for Google Sheets report endpoints
# Send it as `x-report-key: <key>`.
SHEETS_REPORT_KEY=replace-with-a-long-random-key

# Optional email provider configuration for automated reports.
# Leave unset to keep email reporting disabled.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# Super admin — sign in with these; the account is created automatically
SUPER_ADMIN_NAME=Owner
SUPER_ADMIN_USERNAME=owner
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me-now
